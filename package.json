{
  "name": "dsh-tool-lazy-dispatcher",
  "version": "1.2.0",
  "description": "Dynamic tool lazy folding and progressive disclosure dispatcher for DeepSeek Harness (DSH) and Cordis",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "cordis",
    "deepseek-harness",
    "dsh",
    "llm",
    "tools",
    "kv-cache",
    "token-optimization",
    "progressive-disclosure",
    "lazy-folding",
    "mcp"
  ],
  "author": "tigermkiiiddd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigermkiiiddd/dsh-tool-lazy-dispatcher.git"
  },
  "bugs": {
    "url": "https://github.com/tigermkiiiddd/dsh-tool-lazy-dispatcher/issues"
  },
  "homepage": "https://github.com/tigermkiiiddd/dsh-tool-lazy-dispatcher#readme",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
